# Python cache & environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# Local config & runbook (keeps your private device IP safe)
config.json
OPERATOR_GUIDE.md

# Android Platform-Tools binaries
platform-tools/
*.exe
*.dll
*.zip

# Captured screenshots, UI XML dumps & logs
dumps/
logs/
*.png
*.jpg
*.jpeg
*.mp4
*.xml
*.jsonl

# Allow UI showcase images & demo videos for documentation & GitHub
!docs/screenshots/*
!docs/video/*
!assets/*

# Scratch investigation tools
tools/
